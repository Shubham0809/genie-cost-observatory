DATABRICKS_CONFIG_PROFILE=your-cli-profile
DATABRICKS_WAREHOUSE_ID=your_sql_warehouse_id
# Optional for local budget-panel development. Customer deploy uses scripts/deploy.sh,
# which looks these up and injects them. Do not commit real values.
DATABRICKS_ACCOUNT_ID=your_databricks_account_id
DATABRICKS_ACCOUNT_HOST=https://accounts.cloud.databricks.com
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=genie-cost-observatory
